        },
        {
          "if": {"required": ["claim_revision"]},
          "then": {"required": ["card_id", "card_revision"]}
        },
        {
          "if": {"not": {"required": ["card_id"]}},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["card_revision"]},
                {"required": ["claim_revision"]}
              ]
            }
          }
        }
      ]
